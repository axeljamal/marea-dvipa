// Serves the built app (dist-single) as static files on Cloudflare Workers.
// Deploy: npm run build:single && npx wrangler deploy
{
  "name": "marea-dvipa",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist-single" },
  // marea-dvipa.uk; the workers.dev address stays on so older links keep working
  "routes": [{ "pattern": "marea-dvipa.uk", "custom_domain": true }],
  "workers_dev": true
}
