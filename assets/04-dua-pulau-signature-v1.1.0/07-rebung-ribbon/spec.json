{
  "id": "rebung-ribbon",
  "title": "Rebung Ribbon",
  "collection": "Dua Pulau signature",
  "version": "1.1.0",
  "status": "LOCKED",
  "locked_at": "2026-10-27T01:48:50Z",
  "authorship": "Original procedural motif: source/rebung.js draws it along any path; source/make_samples.js renders the locked samples. Same code runs in Batik Pattern Studio.",
  "kind": "path-following ribbon (not a fixed image)",
  "api": {
    "rebungRibbon(points, halfHeight, colourway, phase)": "returns shapes {d, fill, stroke, sw} or {dot, r, fill} for one polyline of [x, y] points",
    "rebungToSvg(svgElement, shapes)": "draws the shapes into an SVG element (browser)",
    "rebungToCanvas(ctx2d, shapes)": "draws the shapes onto a canvas",
    "polyFromPath(svgPathD, step)": "samples any SVG path string into polylines (browser)"
  },
  "geometry": {
    "shoot_spacing": "1.25 x half-height",
    "rows": "two, offset by half a step, pointing to the spine",
    "edge_band": "0.16 x half-height",
    "skip_rule": "no shoots where the curve turns more than 0.75 rad within one shoot width"
  },
  "samples": [
    "rebung-ribbon-golden-arcs--buya-bomba.svg",
    "rebung-ribbon-golden-arcs--dua-pulau.svg",
    "rebung-ribbon-golden-spiral--buya-bomba.svg",
    "rebung-ribbon-golden-spiral--dua-pulau.svg",
    "rebung-ribbon-straight--buya-bomba.svg",
    "rebung-ribbon-straight--dua-pulau.svg",
    "rebung-ribbon-wave--buya-bomba.svg",
    "rebung-ribbon-wave--dua-pulau.svg"
  ],
  "origins": {
    "inspired_by": "The same inward-facing rebung borders of the Donggala buya bomba, whose framing bands run unbroken along the cloth.",
    "made_our_own": "A ribbon that is drawn live along any path, straight, diagonal, wave, golden spiral or golden arcs, with every shoot bending to the curve, rows offset by half a step, and a zigzag cecek spine. It skips curves too tight for the band rather than crumpling.",
    "meaning_honoured": "Power, greatness and triumph, now flowing with the pattern.",
    "sources": [
      {
        "title": "Inayah & Fatimah, Analisis Ikonografi Kain Tenun Donggala Bermotif \"Buya Bomba\", Societies 5(1), 2025",
        "url": "https://ojs.unm.ac.id/societies/article/view/73950"
      }
    ]
  },
  "colourways": {
    "dua-pulau": {
      "gold": "#C39B65",
